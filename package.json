{
  "name": "railwatch",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "fetch": "tsx scripts/fetch.ts",
    "recompute": "tsx scripts/recompute.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "keywords": [
    "remittance",
    "india",
    "usd-inr",
    "stablecoin",
    "usdc",
    "swift",
    "fx",
    "tds",
    "gst",
    "cost-model"
  ],
  "author": "Agnij Dutta (https://x.com/0xholmesdev)",
  "license": "MIT",
  "description": "Live, hop-by-hop cost of sending USD to an Indian bank account: bank wires, remittance providers and a USDC route, every number cited.",
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "private": true,
  "type": "module",
  "homepage": "https://github.com/agnij-dutta/railwatch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agnij-dutta/railwatch.git"
  },
  "bugs": {
    "url": "https://github.com/agnij-dutta/railwatch/issues"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
